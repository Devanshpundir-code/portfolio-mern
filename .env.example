# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/portfolio_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_db

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Optional: Email Notifications (Nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# CONTACT_RECIPIENT_EMAIL=your_email@gmail.com
